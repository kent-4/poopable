{
  "expo": {
    "name": "poopable-app",
    "slug": "poopable-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.poopable-app"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Poopable uses your location only when you choose Use current location to find nearby restrooms. You can choose an area manually instead.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "scheme": "poopable"
  }
}

# Local emulator scripts only. Copy to .env.local; Node 24 supports --env-file.
POOPABLE_FIREBASE_PROJECT_ID=demo-poopable
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# No cloud project or credentials are needed. No service-account keys belong here.
# Future public Firebase client settings are configuration, never authorization.

# App modes: demo (fictional session), emulator (explicit host), firebase (live project).
# Missing mode shows recoverable setup; no cloud service is selected by default.
# EXPO_PUBLIC_DATA_MODE=emulator
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-poopable
# EXPO_PUBLIC_FIREBASE_API_KEY=fake-emulator-key
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Physical devices need your computer's reachable LAN hostname/IP instead of loopback.
# Live mode requires real owner-provided public client settings, an auth domain,
# deployed rules, and email/password provider enabled separately.
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Android development/standalone builds only; Expo Go supplies its own maps setup.
# Restrict this key to Maps SDK for Android, your Android package and signing SHA-1.
# MAPS_ANDROID_API_KEY=your-restricted-google-maps-key
